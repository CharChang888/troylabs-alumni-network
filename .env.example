# Copy to .env.local and fill in values. Never commit secrets.

# Supabase (leave empty to keep local demo login)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (magic-link redirects and message links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Semantic search (text-embedding-3-small)
OPENAI_API_KEY=

# Optional: real iMessage/SMS
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=

# Optional: geocoding beyond the hardcoded city list
NEXT_PUBLIC_MAPBOX_TOKEN=
